{
  "version": 2,
  "builds": [
    { "src": "**/*.php", "use": "@vercel/php" },
    { "src": "public/**/*", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/(.*)$", "dest": "/index.php" }
  ]
}
